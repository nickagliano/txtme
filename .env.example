# ── SMTP ──────────────────────────────────────────────────────────────────────
# Gmail is the easiest option. Generate an App Password at:
#   https://myaccount.google.com/apppasswords
# (you must have 2FA enabled on your Google account)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"  # 16-char Gmail App Password (quotes required)

# ── Carrier gateway ───────────────────────────────────────────────────────────
# Your 10-digit phone number + your carrier's gateway domain.
# Verizon:   5551234567@vtext.com
# AT&T:      5551234567@txt.att.net
# T-Mobile:  5551234567@tmomail.net

SMS_GATEWAY=5551234567@vtext.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# Other EPS must include this in the X-Api-Key header.
# Leave empty to disable auth (fine if you're only on a private tailnet).

TXTME_API_KEY=change_me

# ── Port (overridden by EPC) ──────────────────────────────────────────────────
PORT=5543
